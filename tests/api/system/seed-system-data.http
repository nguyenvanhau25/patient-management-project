### 0. LOGIN AS ADMIN
POST http://localhost:4004/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "password123"
}

> {% client.global.set("auth_token", response.body.token); %}

### 1. SEED DOCTORS
POST http://localhost:4004/api/doctors
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "id": "1f2e3d4c-5b61-4c32-b1a0-d9e8f7a6b5c4",
  "name": "Nguyên Văn A",
  "email": "doctorA@example.com",
  "specialization": "Nội tổng quát",
  "phoneNumber": "0123456789",
  "experienceYears": 10,
  "firstName": "Văn A",
  "lastName": "Nguyễn",
  "bio": "Bác sĩ nhiều kinh nghiệm",
  "qualifications": "Bác sĩ chuyên khoa I",
  "licenseNumber": "BS123456",
  "location": "Hà Nội",
  "consultationFee": 300000,
  "rating": 4.8
}

### 2. SEED PATIENT
POST http://localhost:4004/api/patients
Authorization: Bearer {{auth_token}}
